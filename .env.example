# =========================================================
# Claves de EmailJS para el formulario de contacto.
# 1. Copia este archivo y renómbralo a ".env" (sin .example).
# 2. Reemplaza los valores con los de tu cuenta en https://www.emailjs.com
#    - Service ID:  Email Services  -> tu servicio (ej. service_abc123)
#    - Template ID: Email Templates -> tu plantilla (ej. template_xyz789)
#    - Public Key:  Account -> General -> Public Key
# 3. Reinicia "npm run dev" para que Vite lea los cambios.
#
# Si el archivo .env no existe, el formulario funciona en "modo demo":
# valida todo y muestra el agradecimiento, pero no envía el correo.
#
# La plantilla de EmailJS puede usar estas variables:
#   {{nombre}} {{apellidos}} {{correo}} {{telefono}} {{descripcion}}
# =========================================================

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
